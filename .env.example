# Copy to .env and fill in values. Never commit .env.

# PostgreSQL. docker-compose.yml builds DATABASE_URL from the POSTGRES_* values.
DATABASE_URL=postgresql://kcpersonal:CHANGE_ME@localhost:5432/kcpersonal
POSTGRES_USER=kcpersonal
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=kcpersonal

# Better Auth. BETTER_AUTH_URL is the public URL of the service (used in sign-in links).
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://kcpersonal.example.se

# SMTP for sign-in links. Leave SMTP_HOST empty in development to log links instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="kcpersonal <noreply@example.se>"

# Time zone
TZ=Europe/Stockholm

# Fortnox (later milestone)
# FORTNOX_CLIENT_ID=
# FORTNOX_CLIENT_SECRET=
