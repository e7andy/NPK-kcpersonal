# Kopiera till .env och fyll i värden. Checka aldrig in .env.

# Publik URL där tjänsten nås (används i inloggningslänkar)
APP_URL=https://kcpersonal.example.se

# PostgreSQL
DATABASE_URL=postgresql://kcpersonal:CHANGE_ME@db:5432/kcpersonal
POSTGRES_USER=kcpersonal
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=kcpersonal

# Better Auth
# Generera med: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://kcpersonal.example.se

# SMTP för inloggningslänkar
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="kcpersonal <noreply@example.se>"

# Tidszon
TZ=Europe/Stockholm

# Fortnox (senare etapp)
# FORTNOX_CLIENT_ID=
# FORTNOX_CLIENT_SECRET=
