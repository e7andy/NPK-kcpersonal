# Copy to .env and fill in values. Never commit .env.

# PostgreSQL database of the Virtualmin sub-server
DATABASE_URL=postgresql://USER:CHANGE_ME@127.0.0.1:5432/kcpersonal

# Better Auth. BETTER_AUTH_URL is the public URL of the service (used in sign-in links).
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://kcpersonal.npk.nu

# SMTP for sign-in links. On the server: SMTP_HOST=localhost (the local
# Postfix, no login). Leave SMTP_HOST empty in development to log links instead.
SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="kcpersonal <noreply@npk.nu>"

# Time zone (also set by the systemd unit)
TZ=Europe/Stockholm

