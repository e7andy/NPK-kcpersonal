# systemd unit for kcpersonal.
#
# Install as root:
#   cp deploy/kcpersonal.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now kcpersonal
#
# Runs as the Virtualmin user of npk.nu, from the kcpersonal.npk.nu
# sub-server's home. See docs/drift.md.

[Unit]
Description=kcpersonal – schedules for kanotcentralen
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=npk.nu
Group=npk.nu
WorkingDirectory=/home/npk.nu/domains/kcpersonal.npk.nu/app
Environment=NODE_ENV=production
Environment=TZ=Europe/Stockholm

# The app listens on a unix socket in /run/kcpersonal. systemd creates the
# directory for the app user; the group is then set to www-data so that only
# the app user and Apache can enter it. Other users on the server can neither
# connect to nor replace the socket.
RuntimeDirectory=kcpersonal
RuntimeDirectoryMode=0750
ExecStartPre=+/usr/bin/chgrp www-data /run/kcpersonal
Environment=SOCKET_PATH=/run/kcpersonal/kcpersonal.sock
ExecStart=/usr/bin/node server.mjs

Restart=on-failure
RestartSec=5

# Resource limits
MemoryMax=512M

# Hardening: besides its socket, the app only writes to its own .next cache.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/npk.nu/domains/kcpersonal.npk.nu/app/.next
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
